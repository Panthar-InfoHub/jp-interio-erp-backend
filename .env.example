NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Neon: POOLED connection (host contains "-pooler"), used by the app at runtime
DATABASE_URL=

# Neon: DIRECT connection (no "-pooler"), used by the Prisma CLI for migrations
DIRECT_URL=

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# One shared secret (32+ characters) that signs login tokens and scrambles OTPs and
# refresh tokens. Changing it logs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Encrypts PAN, Aadhaar, GST, bank account numbers and UPI IDs in the database.
# 32 random bytes in base64. NEVER lose or change it: saved numbers can't be read
# without it. Keep a safe copy, and use a different key in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KYC_ENCRYPTION_KEY=

# Cloudflare R2 file storage (public bucket, apps upload directly with signed links).
# The API token needs "Object Read & Write" on this bucket only. Never commit the keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jp-interio-files
# The bucket's public link (r2.dev link or custom domain), no slash at the end.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev
# Folder in front of every file: "dev" on development machines, "prod" in production.
STORAGE_PREFIX=dev

# How login OTPs are sent: "dummy" prints them in the terminal (development only,
# refused in production), "msg91" sends a real SMS.
SMS_PROVIDER=dummy

# MSG91 Flow API, needed only when SMS_PROVIDER=msg91. Never commit the real key.
# MSG91_OTP_TEMPLATE_ID is MSG91's own template ID (not the long DLT number).
# MSG91_OTP_VARIABLE is the template variable that gets the OTP (##otp## -> otp).
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_VARIABLE=otp

# Test phones log in with TEST_OTP and never get an SMS (testing, app-store review).
# Comma-separated 10-digit mobiles. Anyone who knows TEST_OTP can log in as them.
# Off in production unless ALLOW_TEST_PHONES_IN_PRODUCTION=true.
TEST_PHONES=
TEST_OTP=
ALLOW_TEST_PHONES_IN_PRODUCTION=false

# First Admin, created by `npm run db:seed` (only if no Admin exists yet).
# Phone: 10-digit Indian mobile; stored as 91XXXXXXXXXX. Email is optional.
SEED_ADMIN_NAME="JP Interio Admin"
SEED_ADMIN_PHONE="9876543210"
SEED_ADMIN_EMAIL=""

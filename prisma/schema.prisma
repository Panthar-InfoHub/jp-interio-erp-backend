generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventions: UUID ids (v7, time-ordered), UTC timestamps (timestamptz),
// camelCase in code mapped to snake_case in the database.

// ---- Enums ----

/// Which app a role signs in to.
enum AppType {
  web
  field
  partner

  @@map("app_type")
}

enum UserStatus {
  active
  suspended
  deactivated

  @@map("user_status")
}

enum ZoneStatus {
  active
  inactive

  @@map("zone_status")
}

/// The feature areas an Admin can give a Sub-Admin (DEC-019).
/// `requests` was `leads_requests` until Module 11 (DEC-157, DEC-159).
enum SubAdminArea {
  products
  qr
  rewards
  partners
  tasks
  requests

  @@map("sub_admin_area")
}

enum PartnerType {
  carpenter
  dealer
  oem

  @@map("partner_type")
}

enum KycState {
  not_submitted
  pending
  verified
  rejected

  @@map("kyc_state")
}

/// The next onboarding step to show; the partner or staff member resumes here (DEC-074, DEC-079).
enum OnboardingStep {
  /// Name, email, address, city, state, pincode, zone, partner type, business name (DEC-087, DEC-088).
  basic_info
  /// NOT USED any more: the type is picked on the basic info page (DEC-087, DEC-088).
  /// Left in place for now; remove in a later migration.
  partner_type
  /// Dealer / OEM only: firm name, GST number + certificate, director's DOB, anniversary, spouse.
  firm_details
  /// At least one bank account or UPI ID (DEC-074, DEC-076).
  payout_account
  /// PAN number + photo, Aadhaar number + one photo (DEC-081, DEC-082).
  kyc_documents
  /// Sent for approval; partner type is now locked.
  submitted

  @@map("onboarding_step")
}

enum KycDocType {
  pan
  aadhaar
  /// Dealer / OEM only: GST number + certificate photo (DEC-080).
  gst

  @@map("kyc_doc_type")
}

enum PayoutMethod {
  bank
  upi

  @@map("payout_method")
}

/// Each step in a partner's review history (insert-only, never overwritten).
enum KycReviewAction {
  submitted
  approved
  rejected
  /// Admin undid a rejection (DEC-074); the partner goes back to pending.
  rejection_undone

  @@map("kyc_review_action")
}

enum SettingType {
  int
  string
  bool
  json

  @@map("setting_type")
}

/// Why a session was ended before it expired.
enum SessionRevokeReason {
  logout
  logout_all
  /// A partner logged in on another device (one device only, DEC-032).
  new_device_login
  /// An old refresh token was used again: treated as stolen.
  token_reuse
  user_deactivated
  admin_revoked

  @@map("session_revoke_reason")
}

/// On whose records a role may do an action (DEC-048, docs/Permission Matrix.md).
enum PermissionScope {
  /// Every record, every zone (Admin; Sub-Admin with the area).
  full
  /// Records in their own zone (Zonal Head).
  scoped
  /// Own or assigned records; for an ASM also their Sales Executives' (ASM, Sales Executive, Partner).
  own

  @@map("permission_scope")
}

/// Life of a QR batch (Module 7). Codes never expire (DEC-117).
enum QrBatchStatus {
  /// Made, not downloaded yet.
  generated
  /// Downloaded for printing at least once (can be downloaded again, DEC-118).
  exported
  /// Cancelled with a reason; its unscanned codes no longer work (DEC-117).
  voided

  @@map("qr_batch_status")
}

/// Life of one QR code (Module 7). No `expired`: codes never expire (DEC-117).
enum QrCodeStatus {
  /// Not scanned yet; can still earn points.
  active
  /// Scanned by a partner (Module 9). Stays scanned even if the batch is voided.
  scanned
  /// Its batch was voided before it was scanned.
  void

  @@map("qr_code_status")
}

/// Kind of point movement in `rewards_ledger` (Module 8). Only the ledger service writes these.
enum LedgerEntryType {
  /// Points from a scanned QR code (Module 9). Available up; lifetime earned up.
  earn
  /// Cash-out requested (Module 10). Available → held.
  hold
  /// Cash-out declined or cancelled. Held → available.
  release
  /// Cash-out paid. Held removed; lifetime redeemed up.
  redeem
  /// A paid cash-out whose transfer failed later (DEC-128). Available up; lifetime redeemed down.
  refund
  /// Manual credit or debit by Admin / Rewards Sub-Admin, reason required (DEC-020).
  /// Changes available and net adjusted; a debit never takes available below zero (DEC-128).
  adjust

  @@map("ledger_entry_type")
}

/// Which way the points went for the partner. credit = points come to the partner
/// (earn, release, refund, adjust credit); debit = points leave available or held
/// (hold, redeem, adjust debit). The exact effect is in `available_after` / `held_after`.
enum LedgerDirection {
  credit
  debit

  @@map("ledger_direction")
}

/// What caused a ledger entry. `source_id` points to that record.
enum LedgerSourceType {
  /// A QR code scan (Module 9); source_id = the QR code.
  scan
  /// A cash-out request (Module 10); source_id = the request. Used by hold, release, redeem, refund.
  payout
  /// A manual adjustment; no source_id.
  adjustment

  @@map("ledger_source_type")
}

/// Why a verified partner's scan was refused (Module 9, DEC-139, DEC-140).
enum ScanFailReason {
  /// No such code, not a code at all, or a link from a site other than jpinterio.in.
  invalid_code
  /// Someone else already scanned it ("This code has already been redeemed").
  already_scanned
  /// Its batch was voided before it was scanned.
  voided

  @@map("scan_fail_reason")
}

/// Where a cash-out is in its life (Module 10, DEC-148 – DEC-150). No Processing step and
/// no partner cancel. requested → approved → paid; requested / approved → declined;
/// paid → failed.
enum PayoutStatus {
  /// Asked for by the partner. Points held (`hold`).
  requested
  /// Approved by staff. Status only: the points stay held.
  approved
  /// Money sent by hand and marked paid. Held points leave (`redeem`).
  paid
  /// Refused by staff (reason required), from requested or approved. Points back (`release`).
  declined
  /// Marked paid, but the transfer failed later (reason required). Points back (`refund`).
  failed

  @@map("payout_status")
}

/// How staff actually paid (DEC-148). May differ from the account the partner picked (DEC-149).
enum PayoutPaidMethod {
  cash
  upi
  bank_transfer

  @@map("payout_paid_method")
}

/// Shipment (priced) or free sample (DEC-007, DEC-158).
enum RequestCategory {
  shipment
  sample

  @@map("request_category")
}

/// Where a shipment / sample request is in its life (Module 11, DEC-159 – DEC-162).
/// Every move is permanent: no skipping, no going back.
/// Shipment: requested → accepted → payment_received → processing → dispatched → delivered → completed.
/// Sample (free): requested → accepted → processing → dispatched → delivered → completed.
/// requested → rejected. accepted / payment_received / processing → cancelled;
/// cancelled after payment → refund_initiated → refunded.
enum RequestStatus {
  /// Sent by the partner from the app.
  requested
  /// Handler agreed the price with the partner (shipments; samples have no price).
  accepted
  /// Only from requested; reason required. End stage.
  rejected
  /// Shipments only: money received (date, mode, reference, optional receipt).
  payment_received
  processing
  dispatched
  delivered
  /// End stage.
  completed
  /// By the partner or the handler, before dispatched; reason required. End stage unless
  /// money was received, then the refund stages follow.
  cancelled
  refund_initiated
  /// Full agreed amount returned (date, mode, reference, optional receipt). End stage.
  refunded

  @@map("request_status")
}

/// How money was received or refunded (DEC-160). Reference number required except cash.
enum RequestPaymentMode {
  cash
  upi
  cheque
  bank

  @@map("request_payment_mode")
}

/// What one history row records (DEC-166).
enum RequestEventType {
  /// The partner sent the request (to status `requested`).
  created
  /// A stage move (from → to), with the reason for reject / cancel.
  status_change
  /// The ASM gave the request to a Sales Executive, took it back, or moved it (DEC-160).
  handler_change

  @@map("request_event_type")
}

// ---- Models ----

/// The 6 fixed roles. Seeded, never created from the API.
model Role {
  id   Int     @id @db.SmallInt
  key  String  @unique @db.VarChar(30)
  name String  @db.VarChar(50)
  /// 0 = Admin … 5 = Partner
  tier Int     @db.SmallInt
  app  AppType

  users       User[]
  permissions Permission[]

  @@map("roles")
}

/// The permission matrix: one row = this role may do this action, on these records.
/// No row = refused (default deny). Filled by the seed from code, no admin screen (DEC-043).
/// Sub-Admin rows are also limited by their areas in `sub_admin_areas` (checked in code).
model Permission {
  roleId     Int             @map("role_id") @db.SmallInt
  /// An action name from `src/config/capabilities.ts`, e.g. "kyc.verify". Text, not an enum (DEC-048).
  capability String          @db.VarChar(60)
  scope      PermissionScope

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  role Role @relation(fields: [roleId], references: [id])

  @@id([roleId, capability])
  @@map("permissions")
}

model Zone {
  id     String     @id @default(uuid(7)) @db.Uuid
  name   String     @db.VarChar(100)
  /// Cannot change once anything uses the zone (enforced in the service).
  code   String     @unique @db.VarChar(20)
  region String?    @db.VarChar(100)
  state  String?    @db.VarChar(100)
  status ZoneStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users           User[]
  scans           Scan[]
  payouts         Payout[]
  partnerRequests PartnerRequest[]

  @@map("zones")
}

/// One table for staff and partners. One phone = one account = one role (DEC-022).
model User {
  id       String     @id @default(uuid(7)) @db.Uuid
  /// Empty for a new partner until onboarding (Module 5); staff always have one (DEC-038).
  name     String?    @db.VarChar(100)
  phone    String     @unique @db.VarChar(15)
  /// Not unique: many partners may share an email (DEC-088). Staff emails are kept
  /// unique among staff in code (user.service.ts).
  email    String?    @db.VarChar(255)
  roleId   Int        @map("role_id") @db.SmallInt
  /// The manager above this user. Empty for the Admin.
  /// For a partner: the owning ASM. Empty for a self sign-up until the Zonal Head
  /// picks the ASM while approving (DEC-074).
  parentId String?    @map("parent_id") @db.Uuid
  /// Empty for Admin and Sub-Admins; set for Zonal Heads and everyone below.
  /// For a self sign-up partner: the zone they picked on the basic info page (DEC-080).
  zoneId   String?    @map("zone_id") @db.Uuid
  status   UserStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  role     Role   @relation(fields: [roleId], references: [id])
  parent   User?  @relation("UserParent", fields: [parentId], references: [id])
  children User[] @relation("UserParent")
  zone     Zone?  @relation(fields: [zoneId], references: [id])

  subAdminAreas         SubAdminAreaGrant[]   @relation("GrantHolder")
  subAdminAreasGranted  SubAdminAreaGrant[]   @relation("GrantGiver")
  partnerProfile        PartnerProfile?       @relation("ProfileOwner")
  assignedPartners      PartnerProfile[]      @relation("ProfileSalesExecutive")
  onboardedPartners     PartnerProfile[]      @relation("ProfileOnboardedBy")
  settingsUpdated       Setting[]
  auditEntries          AuditLog[]
  sessions              Session[]
  kycDocumentsUploaded  KycDocument[]         @relation("DocUploadedBy")
  payoutAccountsAdded   PayoutAccount[]       @relation("PayoutAddedBy")
  payoutAccountsEdited  PayoutAccount[]       @relation("PayoutUpdatedBy")
  payoutAccountsRemoved PayoutAccount[]       @relation("PayoutRemovedBy")
  kycReviewsDone        KycReview[]           @relation("ReviewActor")
  kycReviewsAsmPicked   KycReview[]           @relation("ReviewAssignedAsm")
  qrBatchesCreated      QrBatch[]             @relation("QrBatchCreatedBy")
  qrBatchesVoided       QrBatch[]             @relation("QrBatchVoidedBy")
  qrBatchExports        QrBatchExport[]
  qrCodesScanned        QrCode[]              @relation("QrCodeScannedBy")
  wallet                Wallet?               @relation("WalletOwner")
  ledgerEntries         RewardsLedgerEntry[]  @relation("LedgerPartner")
  ledgerEntriesMade     RewardsLedgerEntry[]  @relation("LedgerCreatedBy")
  scans                 Scan[]                @relation("ScanPartner")
  scansAsOwningAsm      Scan[]                @relation("ScanOwningAsm")
  scanAttempts          ScanAttempt[]
  payouts               Payout[]              @relation("PayoutPartner")
  payoutsAsOwningAsm    Payout[]              @relation("PayoutOwningAsm")
  payoutsApproved       Payout[]              @relation("PayoutApprovedBy")
  payoutsDeclined       Payout[]              @relation("PayoutDeclinedBy")
  payoutsPaid           Payout[]              @relation("PayoutPaidBy")
  payoutsFailed         Payout[]              @relation("PayoutFailedBy")
  requests              PartnerRequest[]      @relation("RequestPartner")
  requestsHandled       PartnerRequest[]      @relation("RequestHandler")
  requestsAsOwningAsm   PartnerRequest[]      @relation("RequestOwningAsm")
  requestPaymentsMade   PartnerRequest[]      @relation("RequestPaymentBy")
  requestRefundsMade    PartnerRequest[]      @relation("RequestRefundBy")
  requestEventsDone     PartnerRequestEvent[] @relation("RequestEventActor")
  requestEventsFrom     PartnerRequestEvent[] @relation("RequestEventFromHandler")
  requestEventsTo       PartnerRequestEvent[] @relation("RequestEventToHandler")

  @@index([roleId])
  @@index([parentId])
  @@index([zoneId])
  @@index([status])
  @@map("users")
}

/// Which areas a Sub-Admin holds. Removing an area deletes the row;
/// the history lives in audit_log (DEC-018, DEC-019).
model SubAdminAreaGrant {
  userId      String       @map("user_id") @db.Uuid
  area        SubAdminArea
  grantedById String       @map("granted_by") @db.Uuid
  grantedAt   DateTime     @default(now()) @map("granted_at") @db.Timestamptz(3)

  user      User @relation("GrantHolder", fields: [userId], references: [id])
  grantedBy User @relation("GrantGiver", fields: [grantedById], references: [id])

  @@id([userId, area])
  @@map("sub_admin_areas")
}

/// Extra details for partners only. Profile fields stay empty until the
/// partner (or field staff) fills them in during onboarding (Module 5).
/// Name and email live on `users`; the zone is `users.zone_id`; the owning ASM is `users.parent_id`.
model PartnerProfile {
  userId           String       @id @map("user_id") @db.Uuid
  /// Firm name: required for dealer / OEM, optional for carpenter (DEC-080, DEC-081).
  businessName     String?      @map("business_name") @db.VarChar(150)
  /// Can change while a draft; locked once submitted (DEC-080).
  partnerType      PartnerType? @map("partner_type")
  address          String?      @db.VarChar(500)
  city             String?      @db.VarChar(100)
  state            String?      @db.VarChar(100)
  pincode          String?      @db.VarChar(6)
  kycState         KycState     @default(not_submitted) @map("kyc_state")
  /// Optional; must report to the partner's owning ASM (checked in the service).
  salesExecutiveId String?      @map("sales_executive_id") @db.Uuid
  /// The ASM or Sales Executive who started a field onboarding. Only they can finish
  /// the draft (DEC-075). Empty for a self sign-up.
  onboardedById    String?      @map("onboarded_by") @db.Uuid

  // Dealer / OEM: director or proprietor details, all optional, one person only (DEC-080).
  ownerDob             DateTime? @map("owner_dob") @db.Date
  ownerAnniversaryDate DateTime? @map("owner_anniversary_date") @db.Date
  ownerSpouseName      String?   @map("owner_spouse_name") @db.VarChar(100)

  // Onboarding progress (drafts, DEC-074).
  onboardingStep      OnboardingStep @default(basic_info) @map("onboarding_step")
  /// When the draft began; unfinished drafts older than one month are removed (DEC-074, DEC-075).
  onboardingStartedAt DateTime       @default(now()) @map("onboarding_started_at") @db.Timestamptz(3)
  submittedAt         DateTime?      @map("submitted_at") @db.Timestamptz(3)
  /// When the latest approve or reject happened. Full history is in `kyc_reviews`.
  reviewedAt          DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  /// Set when the daily clean-up retired this unfinished onboarding (DEC-093): the account
  /// is switched off, its phone released, its documents and payout rows deleted.
  /// Retired drafts are hidden from every list.
  draftRemovedAt      DateTime?      @map("draft_removed_at") @db.Timestamptz(3)
  /// Latest rejection reason, shown to the partner (DEC-073, DEC-074).
  rejectionReason     String?        @map("rejection_reason") @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User  @relation("ProfileOwner", fields: [userId], references: [id])
  salesExecutive User? @relation("ProfileSalesExecutive", fields: [salesExecutiveId], references: [id])
  onboardedBy    User? @relation("ProfileOnboardedBy", fields: [onboardedById], references: [id])

  kycDocuments   KycDocument[]
  payoutAccounts PayoutAccount[]
  kycReviews     KycReview[]

  @@index([kycState])
  @@index([salesExecutiveId])
  // "My unfinished onboardings" list and the one-month draft clean-up.
  @@index([onboardedById, onboardingStep])
  @@index([onboardingStep, onboardingStartedAt])
  @@map("partner_profiles")
}

/// A partner's KYC documents: PAN, Aadhaar and (dealer / OEM) GST.
/// The number is stored encrypted (AES-256-GCM), plus a hash for duplicate checks
/// and the last 4 characters for display. Never log the number (R14).
/// Replacing a document keeps the old row (`replaced_at` set); it is never overwritten.
model KycDocument {
  id              String     @id @default(uuid(7)) @db.Uuid
  partnerId       String     @map("partner_id") @db.Uuid
  docType         KycDocType @map("doc_type")
  numberEncrypted String     @map("number_encrypted")
  /// Keyed hash of the cleaned number. Duplicates are blocked across all
  /// accounts, rejected ones included (DEC-074, DEC-077, DEC-081); checked in the service.
  numberHash      String     @map("number_hash") @db.VarChar(64)
  numberLast4     String     @map("number_last4") @db.VarChar(4)
  /// Complete public URL of the photo / PDF in the R2 bucket (DEC-084, DEC-085).
  fileUrl         String     @map("file_url") @db.VarChar(1000)
  fileMimeType    String     @map("file_mime_type") @db.VarChar(100)
  fileSizeBytes   Int        @map("file_size_bytes")
  uploadedById    String     @map("uploaded_by") @db.Uuid
  /// Set when a newer document of the same type replaces this one.
  replacedAt      DateTime?  @map("replaced_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  partner    PartnerProfile @relation(fields: [partnerId], references: [userId])
  uploadedBy User           @relation("DocUploadedBy", fields: [uploadedById], references: [id])

  @@index([partnerId, docType])
  @@index([docType, numberHash])
  @@map("kyc_documents")
}

/// Where a partner's cash-outs go: bank accounts and UPI IDs (each counts as one account).
/// At least one, no maximum, one default (DEC-076, DEC-078). No approval needed.
/// Removing sets `removed_at`; rows are never deleted.
model PayoutAccount {
  id             String       @id @default(uuid(7)) @db.Uuid
  partnerId      String       @map("partner_id") @db.Uuid
  method         PayoutMethod
  /// Bank: account holder's name. UPI: the name shown for the UPI ID, if given.
  holderName     String?      @map("holder_name") @db.VarChar(150)
  /// Bank account number or UPI ID, encrypted. Never log it (R14).
  valueEncrypted String       @map("value_encrypted")
  /// Keyed hash for duplicate checks across all accounts (DEC-073, DEC-074).
  valueHash      String       @map("value_hash") @db.VarChar(64)
  valueLast4     String       @map("value_last4") @db.VarChar(4)
  /// Bank only.
  ifsc           String?      @db.VarChar(11)
  bankName       String?      @map("bank_name") @db.VarChar(150)
  isDefault      Boolean      @default(false) @map("is_default")
  addedById      String       @map("added_by") @db.Uuid
  updatedById    String?      @map("updated_by") @db.Uuid
  removedAt      DateTime?    @map("removed_at") @db.Timestamptz(3)
  removedById    String?      @map("removed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  partner   PartnerProfile @relation(fields: [partnerId], references: [userId])
  addedBy   User           @relation("PayoutAddedBy", fields: [addedById], references: [id])
  updatedBy User?          @relation("PayoutUpdatedBy", fields: [updatedById], references: [id])
  removedBy User?          @relation("PayoutRemovedBy", fields: [removedById], references: [id])
  payouts   Payout[]

  @@index([partnerId, removedAt])
  @@index([method, valueHash])
  @@map("payout_accounts")
}

/// Insert-only history of a partner's verification: submit, approve, reject, undo.
model KycReview {
  id            String          @id @default(uuid(7)) @db.Uuid
  partnerId     String          @map("partner_id") @db.Uuid
  action        KycReviewAction
  /// Required for `rejected` (free text, DEC-073); optional otherwise.
  reason        String?         @db.VarChar(1000)
  actorId       String          @map("actor_id") @db.Uuid
  /// For `approved` on a self sign-up: the ASM the Zonal Head picked (DEC-074).
  assignedAsmId String?         @map("assigned_asm_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  partner     PartnerProfile @relation(fields: [partnerId], references: [userId])
  actor       User           @relation("ReviewActor", fields: [actorId], references: [id])
  assignedAsm User?          @relation("ReviewAssignedAsm", fields: [assignedAsmId], references: [id])

  @@index([partnerId, createdAt])
  @@map("kyc_reviews")
}

// ---------------------------------------------------------------------------
// Product catalog (Module 6). Nothing here is ever deleted, only switched off.
// Managed by the Admin and the Products & Catalog Sub-Admin (DEC-108).
// ---------------------------------------------------------------------------

/// A product brand. Switching a brand off hides its products from the app catalog
/// and blocks new requests for them; new QR batches are still allowed (DEC-110).
model Brand {
  id      String  @id @default(uuid(7)) @db.Uuid
  /// As typed by the Admin, for display.
  name    String  @db.VarChar(100)
  /// Name cleaned for the "unique, ignoring case" check: trimmed, single spaces,
  /// lower case (DEC-111). Set by the service, never by the client.
  nameKey String  @unique @map("name_key") @db.VarChar(100)
  /// Optional; unique when given, stored in upper case (DEC-111).
  code    String? @unique @db.VarChar(20)
  active  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
}

/// Product categories, nested as deep as the Admin wants (DEC-108). No parent = top level.
/// A category counts as "off" when it or any category above it is switched off;
/// switching a parent back on brings back the ones below (DEC-110, DEC-111).
/// A category can be moved to another parent; the service refuses loops (DEC-111).
model ProductCategory {
  id       String  @id @default(uuid(7)) @db.Uuid
  name     String  @db.VarChar(100)
  /// Cleaned name (trimmed, single spaces, lower case). Unique among categories under
  /// the same parent (DEC-111). The index below covers sub-categories; top-level names
  /// (no parent) are checked in the service.
  nameKey  String  @map("name_key") @db.VarChar(100)
  parentId String? @map("parent_id") @db.Uuid
  /// This category's own switch. Whether it is really "on" also depends on its parents.
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   ProductCategory?  @relation("CategoryParent", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryParent")
  products Product[]

  @@unique([parentId, nameKey])
  @@index([parentId])
  @@map("product_categories")
}

/// One product (SKU). Sits on one category at any level and also counts under every
/// category above it, not under its siblings or the ones below (DEC-109).
/// A switched-off product cannot be picked in new requests or get new QR batches;
/// old records stay valid.
model Product {
  id         String  @id @default(uuid(7)) @db.Uuid
  /// As typed by the Admin, for display.
  sku        String  @db.VarChar(50)
  /// SKU cleaned for the "unique, ignoring case and spaces" check: all spaces removed,
  /// upper case, e.g. "bwp 18mm" → "BWP18MM" (DEC-111). Set by the service.
  skuKey     String  @unique @map("sku_key") @db.VarChar(50)
  name       String  @db.VarChar(200)
  brandId    String  @map("brand_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  // Free text, optional (DEC-108).
  thickness  String? @db.VarChar(50)
  size       String? @db.VarChar(100)
  grade      String? @db.VarChar(50)
  /// Rupees. Partners see it too (DEC-108).
  mrp        Decimal @db.Decimal(12, 2)
  /// Complete public URL of the one product image in the R2 bucket. Required;
  /// can be replaced, never removed (DEC-084, DEC-110, DEC-111).
  imageUrl   String  @map("image_url") @db.VarChar(1000)
  active     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand        Brand                @relation(fields: [brandId], references: [id])
  category     ProductCategory      @relation(fields: [categoryId], references: [id])
  qrBatches    QrBatch[]
  qrCodes      QrCode[]
  scans        Scan[]
  requestItems PartnerRequestItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([active])
  @@map("products")
}

// ---------------------------------------------------------------------------
// QR Code Engine (Module 7). Managed by the Admin and the QR Batches Sub-Admin
// (DEC-018, DEC-019). Nothing here is ever deleted; a batch can only be voided.
// ---------------------------------------------------------------------------

/// One batch of QR codes for one product. Every code in it carries the same points.
/// Making a batch creates money the company may owe, so it is always audited.
model QrBatch {
  id            String        @id @default(uuid(7)) @db.Uuid
  /// Shown to people: `QRB-<year>-<4 digits>`, e.g. QRB-2026-0001 (DEC-120).
  batchNo       String        @unique @map("batch_no") @db.VarChar(20)
  /// UTC year and running number inside that year; the counter restarts at 1 each year.
  year          Int           @db.SmallInt
  seq           Int
  productId     String        @map("product_id") @db.Uuid
  /// Number of codes made. Capped by the `qr.max_batch_size` setting (DEC-119).
  quantity      Int
  /// Points each code gives. Capped by the `qr.max_points_per_code` setting (DEC-119).
  pointsPerCode Int           @map("points_per_code")
  status        QrBatchStatus @default(generated)
  /// Optional free text, e.g. "Pune dealer stock, Dec 2026" (DEC-120).
  notes         String?       @db.VarChar(500)
  createdById   String        @map("created_by_id") @db.Uuid

  /// First download. Later downloads are in `qr_batch_exports` (DEC-118).
  firstExportedAt DateTime? @map("first_exported_at") @db.Timestamptz(3)

  /// Set together when the batch is voided; a reason is required (DEC-117).
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById String?   @map("voided_by_id") @db.Uuid
  voidReason String?   @map("void_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product         @relation(fields: [productId], references: [id])
  createdBy User            @relation("QrBatchCreatedBy", fields: [createdById], references: [id])
  voidedBy  User?           @relation("QrBatchVoidedBy", fields: [voidedById], references: [id])
  codes     QrCode[]
  exports   QrBatchExport[]
  scans     Scan[]

  @@unique([year, seq])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@map("qr_batches")
}

/// One printed QR code. The QR holds `https://www.jpinterio.in/q/<code>` (DEC-118).
model QrCode {
  id        String       @id @default(uuid(7)) @db.Uuid
  /// 12 random Base32 characters, no product data inside (DEC-118). The database
  /// refuses duplicates; the service makes a new one on a clash.
  code      String       @unique @db.VarChar(12)
  batchId   String       @map("batch_id") @db.Uuid
  /// Same as the batch's product; kept here for quick lookups and reports.
  productId String       @map("product_id") @db.Uuid
  status    QrCodeStatus @default(active)

  /// Filled by scanning (Module 9). Empty until then.
  scannedById String?   @map("scanned_by_id") @db.Uuid
  scannedAt   DateTime? @map("scanned_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch     QrBatch       @relation(fields: [batchId], references: [id])
  product   Product       @relation(fields: [productId], references: [id])
  scannedBy User?         @relation("QrCodeScannedBy", fields: [scannedById], references: [id])
  scan      Scan?
  attempts  ScanAttempt[]

  @@index([batchId, status])
  @@index([productId])
  @@index([scannedById])
  @@map("qr_codes")
}

/// Insert-only: one row per download of a batch for printing (DEC-118).
model QrBatchExport {
  id           String @id @default(uuid(7)) @db.Uuid
  batchId      String @map("batch_id") @db.Uuid
  exportedById String @map("exported_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  batch      QrBatch @relation(fields: [batchId], references: [id])
  exportedBy User    @relation(fields: [exportedById], references: [id])

  @@index([batchId, createdAt])
  @@map("qr_batch_exports")
}

// ---------------------------------------------------------------------------
// Points Ledger & Wallet (Module 8). 1 point = ₹1. Only the ledger service
// (`postLedgerEntry`) changes points, inside the caller's transaction.
// Points never expire (DEC-127).
// ---------------------------------------------------------------------------

/// Insert-only passbook: one row per point movement. A database trigger refuses
/// UPDATE, DELETE and TRUNCATE (added by hand in the migration); mistakes are fixed
/// with a new correcting row.
model RewardsLedgerEntry {
  id        String          @id @default(uuid(7)) @db.Uuid
  partnerId String          @map("partner_id") @db.Uuid
  type      LedgerEntryType
  direction LedgerDirection
  /// Always a positive whole number; `direction` says which way.
  points    Int

  /// The partner's balances right after this entry (lets reports answer "as of a date").
  availableAfter Int @map("available_after")
  heldAfter      Int @map("held_after")

  sourceType  LedgerSourceType @map("source_type")
  /// The scan's QR code or the cash-out request. Empty for manual adjustments.
  sourceId    String?          @map("source_id") @db.Uuid
  /// Required for `adjust` (checked in the service); optional otherwise.
  reason      String?          @db.VarChar(500)
  /// Staff who made it. Empty when the system made it (scan, automatic refund).
  createdById String?          @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  partner   User  @relation("LedgerPartner", fields: [partnerId], references: [id])
  createdBy User? @relation("LedgerCreatedBy", fields: [createdById], references: [id])

  /// Retry safety: one scan earns once; one cash-out holds / releases / redeems / refunds
  /// at most once each. Adjustments have no source_id, so they are not limited by this.
  @@unique([sourceType, sourceId, type])
  @@index([partnerId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("rewards_ledger")
}

/// Current totals per partner (a summary; the ledger is the truth). Opened when the
/// partner is verified (Module 5 hook) or by the seed for partners verified earlier
/// (DEC-129). No "frozen" column: a wallet is frozen whenever its partner is not active
/// and verified (DEC-129). Rule kept by the service and a database check:
/// available = lifetime_earned + net_adjusted − lifetime_redeemed − held.
model Wallet {
  partnerId        String @id @map("partner_id") @db.Uuid
  available        Int    @default(0)
  held             Int    @default(0)
  /// Scan points only (`earn`).
  lifetimeEarned   Int    @default(0) @map("lifetime_earned")
  /// Points paid out as money (`redeem`); a `refund` lowers it.
  lifetimeRedeemed Int    @default(0) @map("lifetime_redeemed")
  /// Manual credits − manual debits; can be below zero (DEC-129).
  netAdjusted      Int    @default(0) @map("net_adjusted")
  /// Number of QR codes scanned (Module 9).
  scanCount        Int    @default(0) @map("scan_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  partner User @relation("WalletOwner", fields: [partnerId], references: [id])

  @@map("wallets")
}

// ---------------------------------------------------------------------------
// Scan & Earn (Module 9). A verified partner scans a QR code and gets the batch's
// points once. No location is taken (DEC-138); scans are never limited (DEC-139).
// ---------------------------------------------------------------------------

/// One successful scan. Saved in the same transaction as the code becoming `scanned`,
/// the ledger `earn` line and the audit entry (DEC-138).
model Scan {
  id          String  @id @default(uuid(7)) @db.Uuid
  /// Unique: the database itself allows only one scan per code, even for parallel scans.
  qrCodeId    String  @unique @map("qr_code_id") @db.Uuid
  partnerId   String  @map("partner_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  batchId     String  @map("batch_id") @db.Uuid
  /// The batch's points per code at scan time (never from the app).
  points      Int
  /// The partner's zone and owning ASM at scan time, copied so old scans stay where
  /// they happened if the partner moves later.
  zoneId      String? @map("zone_id") @db.Uuid
  owningAsmId String? @map("owning_asm_id") @db.Uuid
  /// Optional; sent by the app if it has one (DEC-138).
  deviceId    String? @map("device_id") @db.VarChar(100)
  ip          String? @db.VarChar(45)

  scannedAt DateTime @default(now()) @map("scanned_at") @db.Timestamptz(3)

  qrCode    QrCode  @relation(fields: [qrCodeId], references: [id])
  partner   User    @relation("ScanPartner", fields: [partnerId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  batch     QrBatch @relation(fields: [batchId], references: [id])
  zone      Zone?   @relation(fields: [zoneId], references: [id])
  owningAsm User?   @relation("ScanOwningAsm", fields: [owningAsmId], references: [id])

  @@index([partnerId, scannedAt])
  @@index([productId, scannedAt])
  @@index([batchId])
  @@index([zoneId, scannedAt])
  @@index([owningAsmId, scannedAt])
  @@index([scannedAt])
  @@map("scans")
}

/// One refused scan by a verified partner (DEC-140). A record only: no points change.
/// Kept as a fraud signal for Module 17.
model ScanAttempt {
  id        String         @id @default(uuid(7)) @db.Uuid
  partnerId String         @map("partner_id") @db.Uuid
  /// What the app sent, as it was (cut to 500 characters).
  input     String         @db.VarChar(500)
  /// The code read from the input, if it looked like one.
  code      String?        @db.VarChar(12)
  /// The matching QR code, if it exists (already scanned / voided).
  qrCodeId  String?        @map("qr_code_id") @db.Uuid
  reason    ScanFailReason
  deviceId  String?        @map("device_id") @db.VarChar(100)
  ip        String?        @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  partner User    @relation(fields: [partnerId], references: [id])
  qrCode  QrCode? @relation(fields: [qrCodeId], references: [id])

  @@index([partnerId, createdAt])
  @@index([reason, createdAt])
  @@index([qrCodeId])
  @@index([createdAt])
  @@map("scan_attempts")
}

// ---------------------------------------------------------------------------
// Payout Redemption (Module 10). A verified partner cashes points out (1 point = ₹1);
// staff approve, pay by hand outside the platform, and mark it paid (DEC-148 – DEC-151).
// Points move only through `postLedgerEntry` (source type `payout`, source id = this row).
// ---------------------------------------------------------------------------

/// One cash-out request. Never deleted. Each status change is audited by the service.
model Payout {
  id          String       @id @default(uuid(7)) @db.Uuid
  /// Shown to people: `PAY-<year>-<6 digits>`, e.g. PAY-2026-000123 (DEC-150).
  payoutNo    String       @unique @map("payout_no") @db.VarChar(20)
  /// UTC year and running number inside that year; the counter restarts at 1 each year.
  year        Int          @db.SmallInt
  seq         Int
  partnerId   String       @map("partner_id") @db.Uuid
  /// Whole points asked for; at least `payout.min_points` (checked in the service).
  points      Int
  /// Rupees = points × 1, kept as money for reports.
  amount      Decimal      @db.Decimal(12, 2)
  status      PayoutStatus @default(requested)
  /// Optional note from the partner (DEC-151).
  partnerNote String?      @map("partner_note") @db.VarChar(500)

  // ---- The saved account the partner picked, copied at request time (DEC-149, DEC-151).
  // Later edits or removal of that account never change these.
  payoutAccountId       String       @map("payout_account_id") @db.Uuid
  accountMethod         PayoutMethod @map("account_method")
  accountHolderName     String?      @map("account_holder_name") @db.VarChar(150)
  /// Full UPI ID / account number, encrypted (`sensitiveData.ts`). Shown in full to whoever
  /// can see the payout (DEC-083). Never log it (R14).
  accountValueEncrypted String       @map("account_value_encrypted")
  accountLast4          String       @map("account_last4") @db.VarChar(4)
  accountIfsc           String?      @map("account_ifsc") @db.VarChar(11)
  accountBankName       String?      @map("account_bank_name") @db.VarChar(150)

  /// The partner's zone and owning ASM at request time, for reports (DEC-150). Who can
  /// see a payout follows the partner's current owner, not these.
  zoneId      String? @map("zone_id") @db.Uuid
  owningAsmId String? @map("owning_asm_id") @db.Uuid

  /// From the `Idempotency-Key` header; one key per partner makes only one payout.
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)

  // ---- Approve (status only; points stay held).
  approvedById String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(3)

  // ---- Decline (from requested or approved; reason required).
  declinedById  String?   @map("declined_by") @db.Uuid
  declinedAt    DateTime? @map("declined_at") @db.Timestamptz(3)
  declineReason String?   @map("decline_reason") @db.VarChar(500)

  // ---- Paid (by hand). Transaction ID required except for cash; not unique (DEC-149).
  paidById      String?           @map("paid_by") @db.Uuid
  paidAt        DateTime?         @map("paid_at") @db.Timestamptz(3)
  paidMethod    PayoutPaidMethod? @map("paid_method")
  transactionId String?           @map("transaction_id") @db.VarChar(100)
  /// Optional proof photo / screenshot (public R2 URL), any method (DEC-151).
  proofUrl      String?           @map("proof_url") @db.VarChar(1000)

  // ---- Failed after paid (reason required; points back by `refund`).
  failedById    String?   @map("failed_by") @db.Uuid
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(3)
  failureReason String?   @map("failure_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  partner       User          @relation("PayoutPartner", fields: [partnerId], references: [id])
  payoutAccount PayoutAccount @relation(fields: [payoutAccountId], references: [id])
  zone          Zone?         @relation(fields: [zoneId], references: [id])
  owningAsm     User?         @relation("PayoutOwningAsm", fields: [owningAsmId], references: [id])
  approvedBy    User?         @relation("PayoutApprovedBy", fields: [approvedById], references: [id])
  declinedBy    User?         @relation("PayoutDeclinedBy", fields: [declinedById], references: [id])
  paidBy        User?         @relation("PayoutPaidBy", fields: [paidById], references: [id])
  failedBy      User?         @relation("PayoutFailedBy", fields: [failedById], references: [id])

  @@unique([year, seq])
  @@unique([partnerId, idempotencyKey])
  @@index([partnerId, createdAt])
  @@index([status, createdAt])
  @@index([zoneId, status])
  @@index([owningAsmId, status])
  @@index([createdAt])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Requests (Module 11; "leads" are the same thing, DEC-157). A verified partner asks
// for a shipment or a free sample; the handler (Sales Executive, or the ASM) agrees one
// total price and moves it stage by stage (DEC-157 – DEC-166). No reward points involved.
// Nothing here is ever deleted.
// ---------------------------------------------------------------------------

/// One shipment / sample request. Who did each stage and when lives in
/// `partner_request_events` (DEC-166); every change is also audited by the service.
model PartnerRequest {
  id        String          @id @default(uuid(7)) @db.Uuid
  /// Shown to people: `REQ-<year>-<6 digits>`, e.g. REQ-2026-000123 (DEC-163).
  requestNo String          @unique @map("request_no") @db.VarChar(20)
  /// UTC year and running number inside that year; the counter restarts at 1 each year.
  year      Int             @db.SmallInt
  seq       Int
  partnerId String          @map("partner_id") @db.Uuid
  category  RequestCategory
  status    RequestStatus   @default(requested)
  /// Who handles it now: the partner's Sales Executive, else the owning ASM (DEC-158);
  /// the ASM can change it (DEC-160).
  handlerId String          @map("handler_id") @db.Uuid

  /// The partner's zone and owning ASM at request time, for reports. A partner with an
  /// open request can't be transferred (DEC-165), so these stay right while it is open.
  zoneId      String? @map("zone_id") @db.Uuid
  owningAsmId String? @map("owning_asm_id") @db.Uuid

  /// One free-text box, pre-filled from the profile, editable (DEC-163, DEC-166).
  deliveryAddress       String   @map("delivery_address") @db.VarChar(500)
  /// Not in the past when created (checked in the service).
  preferredDeliveryDate DateTime @map("preferred_delivery_date") @db.Date
  notes                 String?  @db.VarChar(500)

  /// One total amount in rupees, typed at Accept; never changed (DEC-159, DEC-161).
  /// Shipments only; empty for samples (free, DEC-158).
  agreedAmount Decimal? @map("agreed_amount") @db.Decimal(12, 2)

  /// From the `Idempotency-Key` header; one key per partner makes only one request.
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)

  // ---- Payment received (shipments only, DEC-160). Date may be past, not future (DEC-166).
  paymentDate         DateTime?           @map("payment_date") @db.Date
  paymentMode         RequestPaymentMode? @map("payment_mode")
  /// Required except for cash (DEC-163).
  paymentReference    String?             @map("payment_reference") @db.VarChar(100)
  /// Optional receipt photo / PDF (public R2 URL, DEC-164).
  paymentReceiptUrl   String?             @map("payment_receipt_url") @db.VarChar(1000)
  paymentRecordedById String?             @map("payment_recorded_by") @db.Uuid
  paymentRecordedAt   DateTime?           @map("payment_recorded_at") @db.Timestamptz(3)

  // ---- Refunded (always the full agreed amount, DEC-163). Same fields as payment.
  refundDate         DateTime?           @map("refund_date") @db.Date
  refundMode         RequestPaymentMode? @map("refund_mode")
  refundReference    String?             @map("refund_reference") @db.VarChar(100)
  refundReceiptUrl   String?             @map("refund_receipt_url") @db.VarChar(1000)
  refundRecordedById String?             @map("refund_recorded_by") @db.Uuid
  refundRecordedAt   DateTime?           @map("refund_recorded_at") @db.Timestamptz(3)

  /// Free text, 10 – 500 characters (DEC-160, DEC-163). Also saved on the history row.
  rejectReason String? @map("reject_reason") @db.VarChar(500)
  cancelReason String? @map("cancel_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  partner           User                  @relation("RequestPartner", fields: [partnerId], references: [id])
  handler           User                  @relation("RequestHandler", fields: [handlerId], references: [id])
  zone              Zone?                 @relation(fields: [zoneId], references: [id])
  owningAsm         User?                 @relation("RequestOwningAsm", fields: [owningAsmId], references: [id])
  paymentRecordedBy User?                 @relation("RequestPaymentBy", fields: [paymentRecordedById], references: [id])
  refundRecordedBy  User?                 @relation("RequestRefundBy", fields: [refundRecordedById], references: [id])
  items             PartnerRequestItem[]
  events            PartnerRequestEvent[]

  @@unique([year, seq])
  @@unique([partnerId, idempotencyKey])
  @@index([partnerId, status])
  @@index([partnerId, createdAt])
  @@index([handlerId, status])
  @@index([owningAsmId, status])
  @@index([zoneId, status])
  @@index([createdAt])
  @@map("partner_requests")
}

/// One product in a request. The same product only once per request; no maximum
/// number of items (DEC-165). Name and SKU are copied at request time (DEC-165).
model PartnerRequestItem {
  id          String @id @default(uuid(7)) @db.Uuid
  requestId   String @map("request_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  /// More than 0 (checked by Zod / the service, DEC-167).
  quantity    Int
  productName String @map("product_name") @db.VarChar(200)
  productSku  String @map("product_sku") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request PartnerRequest @relation(fields: [requestId], references: [id])
  product Product        @relation(fields: [productId], references: [id])

  @@unique([requestId, productId])
  @@index([productId])
  @@map("partner_request_items")
}

/// Insert-only timeline of a request (DEC-166): creation, every stage move (with the
/// reason for reject / cancel) and every handler change. Who did it and when.
model PartnerRequestEvent {
  id            String           @id @default(uuid(7)) @db.Uuid
  requestId     String           @map("request_id") @db.Uuid
  type          RequestEventType
  /// Stage moves: from → to. `created`: to = requested.
  fromStatus    RequestStatus?   @map("from_status")
  toStatus      RequestStatus?   @map("to_status")
  /// Handler changes: from → to.
  fromHandlerId String?          @map("from_handler_id") @db.Uuid
  toHandlerId   String?          @map("to_handler_id") @db.Uuid
  /// Reject / cancel reason (DEC-166).
  reason        String?          @db.VarChar(500)
  /// Who did it: the partner (create, partner cancel) or a staff member.
  actorId       String           @map("actor_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request     PartnerRequest @relation(fields: [requestId], references: [id])
  actor       User           @relation("RequestEventActor", fields: [actorId], references: [id])
  fromHandler User?          @relation("RequestEventFromHandler", fields: [fromHandlerId], references: [id])
  toHandler   User?          @relation("RequestEventToHandler", fields: [toHandlerId], references: [id])

  @@index([requestId, createdAt])
  @@index([actorId])
  @@map("partner_request_events")
}

/// Business values the Admin can change without a code change.
/// `value` is stored as text and parsed by `type` in the settings service.
model Setting {
  key         String      @id @db.VarChar(100)
  value       String
  type        SettingType
  description String?     @db.VarChar(500)
  updatedById String?     @map("updated_by") @db.Uuid
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("settings")
}

/// Insert-only record of every change. Kept insert-only by the code: services never
/// update or delete it (no database trigger, DEC-026). Never store secrets in before/after.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Empty for system actions (seed, scheduled jobs).
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  requestId  String?  @map("request_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

/// One row per OTP sent (DEC-033). The OTP itself is never stored, only its hash.
/// Not linked to users: a new partner's phone has no user yet.
model OtpCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  /// Stored as 91XXXXXXXXXX (DEC-031).
  phone     String    @db.VarChar(15)
  app       AppType
  codeHash  String    @map("code_hash") @db.VarChar(64)
  /// Wrong tries so far; the OTP dies at `otp.max_attempts`.
  attempts  Int       @default(0) @db.SmallInt
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the OTP is used successfully; it can never be used again.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  // Latest OTP for a phone + app (verify, resend wait), and per-IP limits (Module 18).
  @@index([phone, app, createdAt])
  @@index([ip, createdAt])
  @@map("otp_codes")
}

/// One row per logged-in device. Only token hashes are stored, never the tokens.
model Session {
  id                String               @id @default(uuid(7)) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  app               AppType
  refreshTokenHash  String               @unique @map("refresh_token_hash") @db.VarChar(64)
  /// The refresh token before the last rotation. Seeing it again = stolen token.
  previousTokenHash String?              @unique @map("previous_token_hash") @db.VarChar(64)
  deviceId          String?              @map("device_id") @db.VarChar(100)
  deviceName        String?              @map("device_name") @db.VarChar(100)
  ip                String?              @db.VarChar(45)
  userAgent         String?              @map("user_agent") @db.VarChar(500)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt        DateTime             @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt         DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokeReason      SessionRevokeReason? @map("revoke_reason")

  user User @relation(fields: [userId], references: [id])

  // A user's active sessions (one-device rule, "my devices", logout-all).
  @@index([userId, revokedAt])
  @@map("sessions")
}
